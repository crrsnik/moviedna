{
  "name": "moviedna",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#firebase-app-check-debug": "./src/shared/config/firebaseAppCheckDebug.js",
    "#firebase-runtime": "./src/shared/config/firebaseRuntime.production.js",
    "#tmdb-app-check-token": "./src/features/catalog/services/tmdbAppCheckToken.js"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/devLocal.js",
    "seed:dna:local": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=demo-moviedna FIREBASE_CONFIG='{\"projectId\":\"demo-moviedna\"}' node scripts/seedDnaLocal.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "firebase:login": "firebase login",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "firebase:deploy:indexes": "firebase deploy --only firestore:indexes",
    "firebase:deploy:firestore": "firebase deploy --only firestore",
    "test:rules": "firebase emulators:exec --only firestore --project demo-moviedna \"node --test tests/firestore.rules.test.js\"",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:bundle": "node --test tests/bundle/*.test.js",
    "test:functions": "npm --prefix functions test",
    "check:functions": "npm --prefix functions run check",
    "test:dna:integration": "firebase emulators:exec --only firestore,functions --project demo-moviedna \"node --test tests/integration/movieDnaFunctions.test.js\"",
    "test:local": "npm run test:unit && npm run test:functions && npm run test:rules && npm run test:dna:integration && npm run test:recommendations:integration && npm run lint && npm run check:functions && npm run build",
    "test:recommendations:integration": "firebase emulators:exec --only firestore --project demo-moviedna \"node --test tests/integration/recommendationFlow.test.js\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.30.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
