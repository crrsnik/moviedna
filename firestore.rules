rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUsername(username) {
      return username is string && username.matches('^[a-z0-9_]{3,20}$');
    }

    function isValidDisplayName(displayName) {
      return displayName is string && displayName.size() >= 1 && displayName.size() <= 50;
    }

    function hasInitialProfileFields(data) {
      let fields = ['username', 'displayName', 'photoURL', 'bio',
                    'onboardingCompleted', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function hasIncompleteProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.onboardingCompleted == false;
    }

    function isValidResponse(data, responseId) {
      let fields = ['tmdbId', 'mediaType', 'reaction', 'genreIds', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && responseId.matches('^[1-9][0-9]{0,11}$')
        && data.tmdbId is int && data.tmdbId > 0
        && string(data.tmdbId) == responseId
        && data.mediaType == 'movie'
        && data.reaction in ['like', 'dislike', 'skip']
        && data.genreIds is list && data.genreIds.size() <= 10
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidSummary(data, userId) {
      let fields = ['version', 'userId', 'status', 'responseCount', 'likedCount',
                    'dislikedCount', 'skippedCount', 'completedAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.version is int && data.version == 1
        && data.userId == userId && data.status == 'completed'
        && data.responseCount is int && data.responseCount >= 10 && data.responseCount <= 30
        && data.likedCount is int && data.likedCount >= 0 && data.likedCount <= data.responseCount
        && data.dislikedCount is int && data.dislikedCount >= 0 && data.dislikedCount <= data.responseCount
        && data.skippedCount is int && data.skippedCount >= 0 && data.skippedCount <= data.responseCount
        && data.likedCount + data.dislikedCount + data.skippedCount == data.responseCount
        && data.completedAt == request.time && data.updatedAt == request.time;
    }

    function hasLibraryText(value, maximum) {
      return value is string && value.size() >= 1 && value.size() <= maximum
        && !value.matches('^[\\s\\p{Z}\\x{000B}\\x{FEFF}]*$');
    }

    function hasLibraryTimestamps(data) {
      return data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidCustomList(data, listId) {
      let fields = ['name', 'description', 'createdAt', 'updatedAt'];
      return listId.matches('^[A-Za-z0-9]{20}$')
        && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && hasLibraryText(data.name, 60)
        && data.description is string && data.description.size() <= 300
        && hasLibraryTimestamps(data);
    }

    function isLibraryPoster(path) {
      return path == null || (path is string && path.size() <= 200
        && path.matches('^/[A-Za-z0-9_./-]+$') && !path.matches('.*[.][.].*'));
    }

    function isValidSavedMedia(data, mediaKey) {
      let fields = ['tmdbId', 'mediaType', 'title', 'posterPath', 'releaseYear',
                    'favorite', 'watchlist', 'listIds', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && mediaKey.matches('^(movie|tv)_[1-9][0-9]{0,11}$')
        && data.tmdbId is int && data.tmdbId >= 1 && data.tmdbId <= 999999999999
        && data.mediaType in ['movie', 'tv']
        && mediaKey == data.mediaType + '_' + string(data.tmdbId)
        && hasLibraryText(data.title, 200) && isLibraryPoster(data.posterPath)
        && (data.releaseYear == null || (data.releaseYear is int
          && data.releaseYear >= 1800 && data.releaseYear <= 2200))
        && data.favorite is bool && data.watchlist is bool
        // No iteration/existence guarantee for individual list IDs; see data model.
        && data.listIds is list && data.listIds.size() <= 20
        && data.listIds.toSet().size() == data.listIds.size()
        && (data.favorite || data.watchlist || data.listIds.size() > 0)
        && hasLibraryTimestamps(data);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list, delete: if false;
      allow update: if isOwner(userId)
        && hasInitialProfileFields(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onboardingCompleted', 'updatedAt'])
        && resource.data.onboardingCompleted == false
        && request.resource.data.onboardingCompleted == true
        && request.resource.data.updatedAt == request.time
        // A pre-existing summary must never be reused for completion.
        && !exists(/databases/$(database)/documents/users/$(userId)/onboarding/summary)
        && isValidSummary(getAfter(/databases/$(database)/documents/users/$(userId)/onboarding/summary).data, userId);
      allow create: if isOwner(userId)
        && hasInitialProfileFields(request.resource.data)
        && isValidUsername(request.resource.data.username)
        && isValidDisplayName(request.resource.data.displayName)
        && request.resource.data.photoURL == null
        && request.resource.data.bio == ''
        && request.resource.data.onboardingCompleted == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        // Reservation must be new in this atomic operation, not pre-existing.
        && !exists(/databases/$(database)/documents/usernames/$(request.resource.data.username))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.userId == userId;

      match /lists/{listId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCustomList(request.resource.data, listId)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) && isValidCustomList(request.resource.data, listId)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /savedMedia/{mediaKey} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSavedMedia(request.resource.data, mediaKey)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) && isValidSavedMedia(request.resource.data, mediaKey)
          && request.resource.data.tmdbId == resource.data.tmdbId
          && request.resource.data.mediaType == resource.data.mediaType
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /onboardingResponses/{responseId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && hasIncompleteProfile(userId)
          && isValidResponse(request.resource.data, responseId)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) && hasIncompleteProfile(userId)
          && isValidResponse(request.resource.data, responseId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction', 'genreIds', 'updatedAt']);
        allow delete: if false;
      }

      match /onboarding/{documentId} {
        allow get: if documentId == 'summary' && isOwner(userId);
        allow list, update, delete: if false;
        allow create: if documentId == 'summary' && isOwner(userId)
          && hasIncompleteProfile(userId)
          && isValidSummary(request.resource.data, userId)
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.onboardingCompleted == true
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.updatedAt == request.time;
      }
    }

    match /usernames/{username} {
      allow get: if isAuthenticated();
      allow list, update, delete: if false;
      allow create: if isAuthenticated()
        && isValidUsername(username)
        && request.resource.data.keys().hasAll(['userId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        // Profile must also be created in this atomic operation.
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
