rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUsername(username) {
      return username is string && username.matches('^[a-z0-9_]{3,20}$');
    }

    function isValidDisplayName(displayName) {
      return displayName is string && displayName.size() >= 1 && displayName.size() <= 50;
    }

    function isValidAvatarId(avatarId) {
      return avatarId in [
        'avatar_01',
        'avatar_02',
        'avatar_03',
        'avatar_04',
        'avatar_05',
        'avatar_06',
        'avatar_07',
        'avatar_08'
      ];
    }

    function isValidProfileVisibility(profileVisibility) {
      return profileVisibility in ['public', 'private'];
    }

    function hasInitialProfileFields(data) {
      let legacyFields = [
        'username',
        'displayName',
        'photoURL',
        'bio',
        'onboardingCompleted',
        'createdAt',
        'updatedAt'
      ];

      let currentFields = [
        'username',
        'displayName',
        'photoURL',
        'bio',
        'avatarId',
        'profileVisibility',
        'onboardingCompleted',
        'createdAt',
        'updatedAt'
      ];

      return (
        data.keys().hasAll(legacyFields)
        && data.keys().hasOnly(legacyFields)
      ) || (
        data.keys().hasAll(currentFields)
        && data.keys().hasOnly(currentFields)
      );
    }

    function isValidPublicProfile(data, userId, userData) {
      let fields = [
        'userId',
        'username',
        'displayName',
        'avatarId',
        'profileVisibility',
        'createdAt',
        'updatedAt'
      ];

      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.userId == userId
        && isValidUsername(data.username)
        && isValidDisplayName(data.displayName)
        && isValidAvatarId(data.avatarId)
        && isValidProfileVisibility(data.profileVisibility)
        && data.username == userData.username
        && data.displayName == userData.displayName
        && data.avatarId == userData.avatarId
        && data.profileVisibility == userData.profileVisibility
        && data.createdAt == userData.createdAt
        && data.updatedAt == request.time;
    }

    function isValidProfileSettingsUpdate(data, previous, userId) {
      return hasInitialProfileFields(data)
        && data.keys().hasAll(['avatarId', 'profileVisibility'])
        && data.diff(previous).affectedKeys().hasOnly([
          'displayName',
          'avatarId',
          'profileVisibility',
          'updatedAt'
        ])
        && isValidDisplayName(data.displayName)
        && isValidAvatarId(data.avatarId)
        && isValidProfileVisibility(data.profileVisibility)
        && data.updatedAt == request.time
        && isValidPublicProfile(
          getAfter(/databases/$(database)/documents/publicProfiles/$(userId)).data,
          userId,
          data
        );
    }

    function hasIncompleteProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.onboardingCompleted == false;
    }

    function isValidResponse(data, responseId) {
      let fields = ['tmdbId', 'mediaType', 'reaction', 'genreIds', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && responseId.matches('^[1-9][0-9]{0,11}$')
        && data.tmdbId is int && data.tmdbId > 0
        && string(data.tmdbId) == responseId
        && data.mediaType == 'movie'
        && data.reaction in ['like', 'dislike', 'skip']
        && data.genreIds is list && data.genreIds.size() <= 10
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidSummary(data, userId) {
      let fields = ['version', 'userId', 'status', 'responseCount', 'likedCount',
                    'dislikedCount', 'skippedCount', 'completedAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.version is int && data.version == 1
        && data.userId == userId && data.status == 'completed'
        && data.responseCount is int && data.responseCount >= 10 && data.responseCount <= 30
        && data.likedCount is int && data.likedCount >= 0 && data.likedCount <= data.responseCount
        && data.dislikedCount is int && data.dislikedCount >= 0 && data.dislikedCount <= data.responseCount
        && data.skippedCount is int && data.skippedCount >= 0 && data.skippedCount <= data.responseCount
        && data.likedCount + data.dislikedCount + data.skippedCount == data.responseCount
        && data.completedAt == request.time && data.updatedAt == request.time;
    }

    function hasLibraryText(value, maximum) {
      return value is string && value.size() >= 1 && value.size() <= maximum
        && !value.matches('^[\\s\\p{Z}\\x{000B}\\x{FEFF}]*$');
    }

    function hasLibraryTimestamps(data) {
      return data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidCustomList(data, listId) {
      let fields = ['name', 'description', 'createdAt', 'updatedAt'];
      return listId.matches('^[A-Za-z0-9]{20}$')
        && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && hasLibraryText(data.name, 60)
        && data.description is string && data.description.size() <= 300
        && hasLibraryTimestamps(data);
    }

    function isLibraryPoster(path) {
      return path == null || (path is string && path.size() <= 200
        && path.matches('^/[A-Za-z0-9_./-]+$') && !path.matches('.*[.][.].*'));
    }

    function isValidMediaIdentity(data, mediaKey) {
      return mediaKey.matches('^(movie|tv)_[1-9][0-9]{0,11}$')
        && data.tmdbId is int && data.tmdbId >= 1 && data.tmdbId <= 999999999999
        && data.mediaType in ['movie', 'tv']
        && mediaKey == data.mediaType + '_' + string(data.tmdbId);
    }

    function isValidMediaSnapshot(data) {
      return hasLibraryText(data.title, 200) && isLibraryPoster(data.posterPath)
        && (data.releaseYear == null || (data.releaseYear is int
          && data.releaseYear >= 1800 && data.releaseYear <= 2200));
    }

    function isValidSavedMedia(data, mediaKey) {
      let fields = ['tmdbId', 'mediaType', 'title', 'posterPath', 'releaseYear',
                    'favorite', 'watchlist', 'listIds', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isValidMediaIdentity(data, mediaKey) && isValidMediaSnapshot(data)
        && data.favorite is bool && data.watchlist is bool
        // No iteration/existence guarantee for individual list IDs; see data model.
        && data.listIds is list && data.listIds.size() <= 20
        && data.listIds.toSet().size() == data.listIds.size()
        && (data.favorite || data.watchlist || data.listIds.size() > 0)
        && hasLibraryTimestamps(data);
    }

    function hasCompletedProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.onboardingCompleted == true;
    }

    function isValidRating(data, mediaKey) {
      let fields = ['tmdbId', 'mediaType', 'title', 'posterPath', 'releaseYear',
                    'score', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isValidMediaIdentity(data, mediaKey) && isValidMediaSnapshot(data)
        && data.score is int && data.score >= 1 && data.score <= 10
        && hasLibraryTimestamps(data);
    }

    function isValidViewingEvent(data, eventId) {
      let fields = ['schemaVersion', 'tmdbId', 'mediaType', 'title', 'posterPath',
                    'releaseYear', 'genres', 'directors', 'creators',
                    'watchedDate', 'createdAt', 'updatedAt'];

      return eventId.matches('^[A-Za-z0-9]{20}$')
        && data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.tmdbId is int && data.tmdbId >= 1
        && data.tmdbId <= 999999999999
        && data.mediaType in ['movie', 'tv']
        && isValidMediaSnapshot(data)
        && data.genres is list && data.genres.size() <= 20
        && data.directors is list && data.directors.size() <= 10
        && data.creators is list && data.creators.size() <= 10
        && (data.mediaType != 'movie' || data.creators.size() == 0)
        && (data.mediaType != 'tv' || data.directors.size() == 0)
        && data.watchedDate is string
        && data.watchedDate.matches('^(19|20|21)[0-9]{2}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])$')
        && hasLibraryTimestamps(data);
    }

    function isValidComment(data, mediaKey) {
      let fields = ['tmdbId', 'mediaType', 'authorUsername', 'authorDisplayName',
                    'text', 'containsSpoiler', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isValidMediaIdentity(data, mediaKey)
        && data.authorUsername is string && data.authorDisplayName is string
        && hasLibraryText(data.text, 2000) && data.containsSpoiler is bool
        && hasLibraryTimestamps(data);
    }

    function matchesAuthorProfile(data, authorId) {
      let profile = get(/databases/$(database)/documents/users/$(authorId)).data;
      return data.authorUsername == profile.username && data.authorDisplayName == profile.displayName;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list, delete: if false;
      allow update: if isOwner(userId)
        && (
          (
            hasInitialProfileFields(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onboardingCompleted', 'updatedAt'])
            && resource.data.onboardingCompleted == false
            && request.resource.data.onboardingCompleted == true
            && request.resource.data.updatedAt == request.time
            // A pre-existing summary must never be reused for completion.
            && !exists(/databases/$(database)/documents/users/$(userId)/onboarding/summary)
            && isValidSummary(
              getAfter(/databases/$(database)/documents/users/$(userId)/onboarding/summary).data,
              userId
            )
          )
          || isValidProfileSettingsUpdate(
            request.resource.data,
            resource.data,
            userId
          )
        );
      allow create: if isOwner(userId)
        && hasInitialProfileFields(request.resource.data)
        && isValidUsername(request.resource.data.username)
        && isValidDisplayName(request.resource.data.displayName)
        && request.resource.data.keys().hasAll(['avatarId', 'profileVisibility'])
        && isValidAvatarId(request.resource.data.avatarId)
        && isValidProfileVisibility(request.resource.data.profileVisibility)
        && request.resource.data.photoURL == null
        && request.resource.data.bio == ''
        && request.resource.data.onboardingCompleted == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        // New registrations must also create the matching public profile atomically.
        && isValidPublicProfile(
          getAfter(/databases/$(database)/documents/publicProfiles/$(userId)).data,
          userId,
          request.resource.data
        )
        // Reservation must be new in this atomic operation, not pre-existing.
        && !exists(/databases/$(database)/documents/usernames/$(request.resource.data.username))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.userId == userId;

      match /lists/{listId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCustomList(request.resource.data, listId)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) && isValidCustomList(request.resource.data, listId)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /savedMedia/{mediaKey} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSavedMedia(request.resource.data, mediaKey)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) && isValidSavedMedia(request.resource.data, mediaKey)
          && request.resource.data.tmdbId == resource.data.tmdbId
          && request.resource.data.mediaType == resource.data.mediaType
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /ratings/{mediaKey} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && hasCompletedProfile(userId)
          && isValidRating(request.resource.data, mediaKey)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) && hasCompletedProfile(userId)
          && isValidRating(request.resource.data, mediaKey)
          && request.resource.data.tmdbId == resource.data.tmdbId
          && request.resource.data.mediaType == resource.data.mediaType
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /viewingHistory/{eventId} {
        allow get, list, delete: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasCompletedProfile(userId)
          && isValidViewingEvent(request.resource.data, eventId)
          && request.resource.data.createdAt == request.time;

        allow update: if isOwner(userId)
          && hasCompletedProfile(userId)
          && isValidViewingEvent(request.resource.data, eventId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['watchedDate', 'updatedAt']);
      }

      // MovieDNA is calculated by a future trusted backend. Clients may read only
      // their two concrete documents and can never list or mutate this collection.
      match /movieDna/{documentId} {
        allow get: if isOwner(userId)
          && documentId in ['current', 'recalculation'];
        allow list, create, update, delete: if false;
      }

      match /onboardingResponses/{responseId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && hasIncompleteProfile(userId)
          && isValidResponse(request.resource.data, responseId)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) && hasIncompleteProfile(userId)
          && isValidResponse(request.resource.data, responseId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction', 'genreIds', 'updatedAt']);
        allow delete: if false;
      }

      match /onboarding/{documentId} {
        allow get: if documentId == 'summary' && isOwner(userId);
        allow list, update, delete: if false;
        allow create: if documentId == 'summary' && isOwner(userId)
          && hasIncompleteProfile(userId)
          && isValidSummary(request.resource.data, userId)
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.onboardingCompleted == true
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.updatedAt == request.time;
      }
    }

    match /mediaComments/{mediaKey}/comments/{commentAuthorId} {
      allow get: if true;
      // Ordering is a client contract; Rules guarantee only the bounded page size.
      allow list: if 'limit' in request.query && request.query.limit is int
        && request.query.limit >= 1 && request.query.limit <= 20;
      allow create: if isOwner(commentAuthorId) && hasCompletedProfile(commentAuthorId)
        && isValidComment(request.resource.data, mediaKey)
        && matchesAuthorProfile(request.resource.data, commentAuthorId)
        && request.resource.data.createdAt == request.time;
      // Author snapshots stay immutable even if the profile changes in the future.
      allow update: if isOwner(commentAuthorId)
        && isValidComment(request.resource.data, mediaKey)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'containsSpoiler', 'updatedAt']);
      allow delete: if isOwner(commentAuthorId);
    }

    // Normalized TMDB signals are an Admin SDK cache, not a client API.
    match /mediaSignals/{mediaKey} {
      allow get, list, create, update, delete: if false;
    }

    match /publicProfiles/{userId} {
      // Owners may always read their mirror. Everyone else may read only
      // profiles whose owner explicitly made them public.
      allow get: if isOwner(userId)
        || resource.data.profileVisibility == 'public';

      // Public profile discovery/search is intentionally not enabled yet.
      allow list: if false;

      // Creation is allowed only as an exact mirror of the private profile.
      // getAfter() also supports the atomic registration transaction.
      allow create: if isOwner(userId)
        && isValidPublicProfile(
          request.resource.data,
          userId,
          getAfter(/databases/$(database)/documents/users/$(userId)).data
        );

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'avatarId',
          'profileVisibility',
          'updatedAt'
        ])
        && isValidPublicProfile(
          request.resource.data,
          userId,
          getAfter(/databases/$(database)/documents/users/$(userId)).data
        );

      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if isAuthenticated();
      allow list, update, delete: if false;
      allow create: if isAuthenticated()
        && isValidUsername(username)
        && request.resource.data.keys().hasAll(['userId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        // Profile must also be created in this atomic operation.
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
